---
/**
 * Menú flotante: barra fija abajo al centro con la habitación actual y un
 * panel desplegable con el plano de la casa y todas las secciones.
 */
import { rooms } from "../data/site";

interface Props {
  home?: boolean;
  /** Texto de la barra cuando no estamos en la portada. */
  label?: string;
}

const { home = false, label = rooms[0].room } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);

// Planta de la casa en un viewBox 120×86.
const shapes: Record<string, { x: number; y: number; w: number; h: number }> = {
  contacto: { x: 2, y: 2, w: 34, h: 36 },
  testimonios: { x: 36, y: 2, w: 40, h: 36 },
  servicios: { x: 76, y: 2, w: 42, h: 36 },
  estudio: { x: 36, y: 38, w: 30, h: 38 },
  proyectos: { x: 66, y: 38, w: 52, h: 38 },
  fachada: { x: 43, y: 76, w: 16, h: 8 },
};
---

<nav class="dock" aria-label="Principal" data-dock>
  <div class="dock__menu" id="dock-menu" data-dock-menu>
    <svg class="dock__plan" viewBox="0 0 120 86" aria-hidden="true">
      <rect class="dock__garden" x="2" y="38" width="34" height="38"></rect>
      {
        rooms.map((r) => {
          const s = shapes[r.id];
          return <rect data-plan={r.id} x={s.x} y={s.y} width={s.w} height={s.h} />;
        })
      }
    </svg>
    <ul>
      {
        rooms.map((r) => (
          <li>
            <a href={to(r.id)} data-go={r.id}>
              <b>{r.room}</b>
              <span>{r.section}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="dock__bar">
    <a class="dock__logo" href={to("fachada")} aria-label="Acosta Interior, inicio">A</a>
    <span class="dock__label" data-dock-label>{label}</span>
    <button class="dock__toggle" type="button" aria-expanded="false" aria-controls="dock-menu" aria-label="Menú">
      <i></i>
      <i></i>
    </button>
  </div>
</nav>

<script>
  const dock = document.querySelector<HTMLElement>("[data-dock]");
  const toggle = dock?.querySelector<HTMLButtonElement>(".dock__toggle");

  if (dock && toggle) {
    const set = (open: boolean) => {
      dock.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    toggle.addEventListener("click", () => set(!dock.hasAttribute("data-open")));
    dock.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) set(false);
    });
    document.addEventListener("click", (event) => {
      if (!dock.contains(event.target as Node)) set(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !dock.hasAttribute("data-open")) return;
      set(false);
      toggle.focus();
    });
  }
</script>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 50;
    translate: -50% 0;
    width: min(17.5rem, calc(100vw - 2rem));
    color: var(--paper);
    --glass: rgba(24, 22, 19, 0.86);
  }

  .dock__bar {
    display: grid;
    grid-template-columns: 2.9rem 1fr 2.9rem;
    align-items: center;
    height: 2.9rem;
    background: var(--glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 0 0 1px rgba(247, 245, 242, 0.1);
  }

  .dock__logo {
    display: grid;
    place-items: center;
    height: 100%;
    font: 400 1.3rem/1 var(--serif);
    border-right: 1px solid rgba(247, 245, 242, 0.12);
  }

  .dock__label {
    text-align: center;
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-inline: 0.75rem;
  }

  .dock__toggle {
    display: grid;
    place-content: center;
    gap: 0.32rem;
    height: 100%;
    border: 0;
    border-left: 1px solid rgba(247, 245, 242, 0.12);
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .dock__toggle i {
    width: 1.05rem;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }

  .dock[data-open] .dock__toggle i:first-child {
    transform: translateY(0.19rem) rotate(45deg);
  }

  .dock[data-open] .dock__toggle i:last-child {
    transform: translateY(-0.19rem) rotate(-45deg);
  }

  .dock__menu {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 0.5rem);
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 0 0 1px rgba(247, 245, 242, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.6rem);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      visibility 0s 0.45s;
  }

  .dock[data-open] .dock__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .dock__plan {
    display: block;
    width: 7.5rem;
    margin: 0 auto 1rem;
    overflow: visible;
  }

  .dock__plan rect {
    fill: rgba(247, 245, 242, 0.08);
    stroke: rgba(247, 245, 242, 0.8);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    transition: fill 0.4s var(--ease);
  }

  .dock__plan rect[aria-current="true"] {
    fill: var(--sage);
  }

  .dock__plan .dock__garden {
    fill: none;
    stroke-dasharray: 2 2;
    opacity: 0.45;
  }

  li + li {
    border-top: 1px solid rgba(247, 245, 242, 0.1);
  }

  li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.62rem 0;
    transition: color 0.3s;
  }

  li b {
    font: italic 400 1.2rem/1 var(--serif);
  }

  li span {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  li a:hover,
  li a[aria-current="true"] {
    color: #c3c6a4;
  }

  @media (prefers-reduced-motion: reduce) {
    .dock__menu,
    .dock__toggle i {
      transition: none;
    }
  }
</style>
