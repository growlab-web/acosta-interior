---
/**
 * Una escena de la casa: una foto a pantalla completa con el contenido encima.
 * En móvil es una sección apilada; en el recorrido de escritorio las escenas se
 * superponen y el scroll hace zoom de una a la siguiente.
 * La fachada es especial (`door`): su pared es un render con el hueco de la
 * puerta recortado, por el que se ve la escena siguiente.
 */
import { Image } from "astro:assets";
import { photo as getPhoto } from "../data/site";

interface Props {
  id?: string;
  /** Sección a la que pertenece (varias escenas pueden compartirla). */
  nav: string;
  /** Nombre de la habitación que se muestra en el menú flotante. */
  room: string;
  label: string;
  photo?: string;
  alt?: string;
  /** Punto de interés de la foto: hacia ahí se hace zoom. */
  focus?: string;
  /** Oscurecimiento de la foto (0 a 1) para que el texto se lea. */
  scrim?: number;
  /** Color del texto de la cabecera sobre esta escena. */
  tone?: "light" | "dark";
  toneWalk?: "light" | "dark";
  door?: boolean;
  /** URL del render de la fachada (solo con `door`). */
  image?: string;
  hint?: string;
  eager?: boolean;
  class?: string;
}

const {
  id,
  nav,
  room,
  label,
  photo,
  alt = "",
  focus = "50% 50%",
  scrim = 0.3,
  tone = "light",
  toneWalk,
  door = false,
  image,
  hint,
  eager = false,
  class: cls,
} = Astro.props;

const vars = [`--focus:${focus}`, `--scrim:${scrim}`];
if (image) vars.push(`--img:url(${image})`);
---

<section
  class:list={["room", cls]}
  id={id}
  aria-label={label}
  data-nav={nav}
  data-room={room}
  data-tone={tone}
  data-tone-walk={toneWalk}
  data-door={door ? "" : undefined}
  style={vars.join(";")}
>
  <div class="room__in">
    <div class="room__out">
      {
        photo && (
          <div class="room__bg">
            <Image
              src={getPhoto(photo)}
              alt={alt}
              widths={[800, 1200, 1800, 2400]}
              sizes="100vw"
              loading={eager ? "eager" : "lazy"}
            />
          </div>
        )
      }
      {
        door && (
          <>
            <div class="room__wall decor" aria-hidden="true" />
            <div class="room__floor decor" aria-hidden="true" />
            <div class="door decor" aria-hidden="true">
              {hint && (
                <span class="door__hint scroll-hint">
                  {hint}
                  <i />
                </span>
              )}
              <slot name="door" />
            </div>
          </>
        )
      }
      <div class="room__content">
        <slot />
      </div>
      {
        hint && !door && (
          <p class="room__hint scroll-hint" aria-hidden="true">
            {hint}
            <i />
          </p>
        )
      }
    </div>
  </div>
</section>
