---
/**
 * Una habitación de la casa. En móvil es una sección normal; en el recorrido
 * de escritorio es un alzado (pared + piso) con el hueco de la puerta que
 * lleva a la siguiente habitación.
 */
interface Props {
  id: string;
  label: string;
  wall: string;
  floor: string;
  /** Hueco de la puerta en fracciones del viewport: x (izquierda), w (ancho), top. */
  door?: { x?: number; w?: number; top?: number };
  /** Pared más ancha que la pantalla: se recorre de lado y la puerta queda al final. */
  wide?: boolean;
  /** Rótulo sobre la puerta: nombre de la habitación siguiente. */
  sign?: string;
  /** Aviso bajo la puerta que invita a seguir deslizando. */
  hint?: string;
  /** Imagen de fondo de la pared (URL ya optimizada). */
  image?: string;
}

const { id, label, wall, floor, door, wide = false, sign, hint, image } = Astro.props;

const vars = [`--wall:${wall}`, `--floor:${floor}`];
if (image) vars.push(`--img:url(${image})`);
if (door) {
  if (door.w !== undefined) vars.push(`--dw:${door.w * 100}vw`);
  if (door.top !== undefined) vars.push(`--dt:${door.top * 100}vh`);
  if (!wide && door.x !== undefined) vars.push(`--dx:${door.x * 100}vw`);
}
// La geometría real del hueco la mide house.ts sobre el elemento .door.
---

<section
  class:list={["room", wide && "room--wide"]}
  id={id}
  aria-label={label}
  data-door={door ? "" : undefined}
  style={vars.join(";")}
>
  <div class="room__in">
    <div class="room__out">
      <div class="room__pan">
        <div class="room__wall decor" aria-hidden="true"></div>
        <div class="room__floor decor" aria-hidden="true"><i></i></div>
        {
          door && (
            <div class="door decor" aria-hidden="true">
              {sign && <span class="door__sign">{sign}</span>}
              <span class="door__beyond" />
              {hint && (
                <span class="door__hint scroll-hint">
                  {hint}
                  <i />
                </span>
              )}
              <slot name="door" />
            </div>
          )
        }
        <div class="room__content">
          <slot />
        </div>
      </div>
    </div>
    <div class="room__shade decor" aria-hidden="true"></div>
  </div>
</section>
