---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
---

<header class:list={["site-header", !home && "site-header--solid"]}>
  <a class="logo" href={to("fachada")} aria-label="Acosta Interior, inicio">
    <b>Acosta</b>
    <span>Interior</span>
  </a>
  <a class="site-header__cta" href={to("contacto")} data-go="contacto">Contacto</a>
</header>
