---
import { getImage, Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Room from "../components/Room.astro";
import { photo, projects, services, studio, testimonials } from "../data/site";
import "../styles/house.css";

// Render de la fachada: es la pared de la portada y de él se recortan las hojas de la puerta.
// Si se cambia la imagen hay que actualizar las medidas en house.css (bloque "Fachada").
const facade = await getImage({ src: photo("fachada"), format: "webp", quality: 90 });

// Fotos de portada de cada proyecto: son los cuadros de la galería en el departamento 3D.
const frames = await Promise.all(
  projects.map((p) => getImage({ src: photo(p.images[0]), width: 1400, format: "webp", quality: 82 })),
);
---

<Base home>
  <main id="house">
    <!-- El departamento en 3D: va detrás de todas las escenas (solo en el recorrido de escritorio). -->
    <canvas class="stage" id="stage" aria-hidden="true" data-photos={JSON.stringify(frames.map((f) => f.src))}></canvas>

    <!-- 1 · Fachada -->
    <Room
      id="fachada"
      nav="fachada"
      room="Fachada"
      label="Inicio"
      photo="fachada"
      scrim={0.25}
      toneWalk="dark"
      door
      image={facade.src}
      hint="Desliza para entrar"
      eager
    >
      <Fragment slot="door">
        <span class="leaf leaf--l"></span>
        <span class="leaf leaf--r"></span>
      </Fragment>

      <h1 class="wordmark display" aria-label="Acosta Interior">
        <span class="wordmark__a" aria-hidden="true">Acosta</span>
        <span class="wordmark__b" aria-hidden="true">Interior</span>
      </h1>
      <div class="hero__copy" data-hero>
        <p class="body">
          Estudio de diseño interior en Lima. Desliza para cruzar la puerta y recorrer la casa, habitación por
          habitación.
        </p>
      </div>
      <div class="hero__cta" data-hero>
        <a class="btn" href="#proyectos">Ver proyectos</a>
      </div>
      <p class="hero__hint scroll-hint" aria-hidden="true" data-hero>Desliza para recorrer la casa<i></i></p>
    </Room>

    <!-- 2 · Recibidor: el estudio -->
    <Room
      id="estudio"
      nav="estudio"
      room="Recibidor"
      label="El estudio"
      photo="room-departamento"
      focus="62% 58%"
      scrim={0.34}
      hint="Desliza"
      eager
      class="room--about"
    >
      <p class="room-name about__name" data-reveal>Recibidor</p>
      <h2 class="display about__title">
        <span class="about__w1" data-blur>Espacios</span>
        <span class="about__w2" data-blur>que reflejan</span>
        <span class="about__w3" data-blur>quién eres</span>
      </h2>
      <p class="body about__body" data-reveal>
        Soy Andrea Acosta, arquitecta y diseñadora de interiores con sede en Lima. Mi trabajo combina rigor técnico con
        sensibilidad artística para crear espacios con propósito, materialidad y emoción.
      </p>
    </Room>

    <!-- 3 · Sala: un proyecto por escena -->
    {
      projects.map((p, i) => (
        <Room
          id={i === 0 ? "proyectos" : undefined}
          nav="proyectos"
          room="Sala"
          label={`Proyecto ${i + 1} de ${projects.length}: ${p.title}`}
          photo={p.images[0]}
          alt={`${p.title}, ${p.place}`}
          scrim={0.3}
          hint="Desliza"
          class="room--project"
        >
          <p class="project__meta caps" data-reveal>
            <span class="room-name">Sala</span>
            Proyecto {i + 1} de {projects.length}
          </p>
          <p class="project__year figure" aria-hidden="true" data-blur>{p.year}</p>
          <h2 class="project__title display" data-blur>{p.title}</h2>
          <p class="project__info caps" data-reveal>
            {p.category}, {p.place}, {p.year}
          </p>
          <a class="project__link btn btn--light" href={`/proyectos/${p.slug}/`} data-reveal>Ver proyecto</a>
        </Room>
      ))
    }

    <!-- 4 · Cocina: servicios -->
    <Room
      id="servicios"
      nav="servicios"
      room="Cocina"
      label="Servicios"
      photo="room-cocina"
      focus="50% 40%"
      scrim={0.66}
      hint="Desliza"
      class="room--kitchen"
    >
      <div class="kitchen__head">
        <p class="room-name" data-reveal>Cocina</p>
        <h2 class="display" data-blur>Servicios</h2>
        <p class="body" data-reveal>Aquí se cocina cada proyecto, del primer boceto a la entrega.</p>
      </div>
      <ul class="services">
        {
          services.map((s) => (
            <li data-reveal>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </Room>

    <!-- 5 · Comedor: testimonios -->
    <Room
      id="testimonios"
      nav="testimonios"
      room="Comedor"
      label="Testimonios"
      photo="room-comedor"
      focus="50% 45%"
      scrim={0.6}
      hint="Desliza"
      class="room--dining"
    >
      <div class="dining__body">
        <p class="room-name" data-reveal>Comedor</p>
        <h2 class="sr-only">Lo que dicen los clientes</h2>
        <div class="quotes" data-reveal>
          {
            testimonials.map((t) => (
              <blockquote class="quote">
                <p>“{t.quote}”</p>
                <footer>
                  <b>{t.author}</b>, {t.project}
                </footer>
              </blockquote>
            ))
          }
        </div>
        <div class="quote-dots" aria-hidden="true" data-reveal>
          {testimonials.map(() => <i />)}
        </div>
      </div>
    </Room>

    <!-- 6 · Estudio: contacto -->
    <Room id="contacto" nav="contacto" room="Estudio" label="Contacto" class="room--contact">
      <div class="contact">
        <div class="contact__intro">
          <p class="room-name" data-reveal>Estudio</p>
          <h2 class="display contact__title" data-blur>¿Comenzamos?</h2>
          <p class="body" data-reveal>
            Cuéntame sobre tu espacio: qué es hoy y cómo quieres vivirlo. Te respondo en un par de días con los
            siguientes pasos.
          </p>
          <p class="contact__links" data-reveal>
            <a class="link" href={`mailto:${studio.email}`}>{studio.email}</a>
            <a class="link" href={studio.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          </p>
        </div>

        <form class="form" data-contact-form data-email={studio.email} data-reveal>
          <div class="field">
            <label for="f-name">Nombre</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-email">Correo</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="f-msg">Tu proyecto</label>
            <textarea id="f-msg" name="message" rows="3" required></textarea>
          </div>
          <div class="form__row">
            <button class="btn btn--light" type="submit">Enviar consulta</button>
            <p class="form__status" role="status" data-form-status></p>
          </div>
        </form>

        <figure class="contact__photo" data-grow>
          <Image
            src={photo("room-estudio")}
            alt="Sala con sofá azul y piso de madera en espiga"
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 24vw, 90vw"
            loading="lazy"
          />
        </figure>
      </div>
      <footer class="house-footer">
        <span>© {new Date().getFullYear()} {studio.name}</span>
        <span>{studio.city}</span>
      </footer>
    </Room>
  </main>
</Base>

<script>
  import "../scripts/house.ts";
</script>
